# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_postgres_password_here

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=secure_rabbitmq_password_here

# Microservice Database Credentials
AUTH_DB_USERNAME=postgres
AUTH_DB_PASSWORD=secure_postgres_password_here
DEVICE_DB_USERNAME=postgres
DEVICE_DB_PASSWORD=secure_postgres_password_here
SENSOR_DB_USERNAME=postgres
SENSOR_DB_PASSWORD=secure_postgres_password_here
ANALYTICS_DB_USERNAME=postgres
ANALYTICS_DB_PASSWORD=secure_postgres_password_here
ALERT_DB_USERNAME=postgres
ALERT_DB_PASSWORD=secure_postgres_password_here

# RabbitMQ Connecting Credentials
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=secure_rabbitmq_password_here

# Security
JWT_SECRET=replace_this_with_a_long_secure_secret_for_production
AI_MSE_THRESH=1.0

# AWS & IoT Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test # Use IAM roles in production instead of keys
AWS_SECRET_ACCESS_KEY=test
AWS_SQS_ENDPOINT=http://localstack:4566
SQS_TELEMETRY_QUEUE=iot-telemetry-queue
SQS_HEARTBEAT_QUEUE=iot-heartbeat-queue

# Gateway <-> service shared secret (defence in depth behind private networking).
# Generate with: openssl rand -hex 32
GATEWAY_INTERNAL_SECRET=replace_with_openssl_rand_hex_32

# First administrator bootstrap (auth-service). Only used when no ADMIN exists.
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AUTH_BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_password_of_at_least_12_chars

# Real-time streaming branch (iot-stream-service).
# rabbit = mirror the SQS branch's bus events locally; aws = subscribe to IoT Core.
IOT_STREAM_SOURCE=rabbit
IOT_STREAM_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# ATS data endpoint, host only, e.g. a1b2c3d4e5-ats.iot.us-east-1.amazonaws.com
AWS_IOT_ENDPOINT=
IOT_TOPIC_PREFIX=weather/devices

# AI live-stream worker cadence (readings between forecasts / reports).
AI_STREAM_FORECAST_EVERY=10
AI_STREAM_REPORT_EVERY=30

# --- AI service hardening ---------------------------------------------------
# Signs the Isolation Forest artifact. Loading a joblib artifact unpickles it,
# which executes whatever is inside, so anything able to write the models volume
# would otherwise get code execution in the AI container. With this set, the
# service refuses an artifact whose HMAC does not match — an attacker who can
# write the file still cannot sign it. Keep it out of the volume itself.
# Generate with: openssl rand -hex 32
AI_MODEL_INTEGRITY_KEY=
# Refuse to start at all unless the artifact verifies. Leave false for local
# sandboxes, set true anywhere the model volume is shared or persistent.
AI_MODEL_INTEGRITY_REQUIRED=false

# Concurrent model calls admitted; the rest get 503 + Retry-After. Inference is
# CPU-bound, so admitting everything under a burst makes every request slower
# rather than serving more of them. Roughly the container's CPU allotment.
AI_MAX_CONCURRENT_INFERENCE=4
# Largest accepted request body / broker message, in bytes.
AI_MAX_REQUEST_BYTES=2097152
AI_MAX_MESSAGE_BYTES=262144
# Smallest dataset POST /api/ai/train will accept. Below this the scaler has too
# little variance to fit and the "trained" model detects nothing.
AI_MIN_TRAINING_SAMPLES=50

# Encrypt the broker connection. Off by default because the local compose stack
# has no certificates; without it the broker password crosses the network in an
# AMQP PLAIN frame in the clear on every reconnect.
RABBITMQ_SSL=false

# --- AI detection tuning ----------------------------------------------------
# These three are ONE decision, not three. Under the noisy-OR combiner in
# anomaly_scorer, a detector's weight is the ceiling of what it can assert
# alone: a weight below the threshold means that detector can never raise an
# anomaly by itself, however certain it is.
#
#   residual 0.8 >= 0.75  the forecast residual can raise an anomaly alone
#   flatline 0.9 >= 0.75  a frozen sensor can raise one alone (it must: a flat
#                         series drives the residual detector to perfect
#                         agreement, so every other detector reads a dead
#                         sensor as healthier than a working one)
#   forest   0.4 <  0.75  the Isolation Forest needs corroboration
#
# Chosen by sweeping them together against labelled data. Re-run the sweep
# after changing any of them:  python -m benchmarks.detection_quality
AI_WEIGHT_IF=0.4
AI_WEIGHT_RESIDUAL=0.8
AI_WEIGHT_FLATLINE=0.9
AI_OVERALL_THRESHOLD=0.75

# Isolation Forest size. Scoring cost is a fixed per-call cost proportional to
# the tree count, and every reading is scored individually, so this is the main
# throughput lever. 50 rather than scikit-learn's 100: measured from 10 to 200
# trees, recall on multivariate outliers stayed at 100% throughout.
#   python -m benchmarks.model_sizing
AI_IF_N_ESTIMATORS=50
# Score sensitivity. Lower is more sensitive.
AI_IF_CALIBRATION_FACTOR=0.30

# Flatline detection. The alarm point is learned per device and per channel:
# a multiple of the longest run that channel has previously completed. A fixed
# threshold cannot work, because instruments quantise — a healthy oxygen sensor
# in calm conditions was measured holding one value for 1,362 consecutive
# readings while every other channel kept moving.
#   python -m benchmarks.flatline_validation
AI_FLATLINE_RUN_MULTIPLIER=4.0
AI_FLATLINE_MIN_RUN=30
AI_FLATLINE_WARMUP_RUNS=5
# Optional ceiling on the learned alarm point; 0 disables it and is recommended.
# It was 3000 and described as a backstop for a sensor frozen before startup. It
# never did that — an un-warmed channel is skipped before the ceiling is read —
# so the only channels it touched were healthy ones whose learned threshold had
# grown past it, which are exactly the quantised-stable ones. Measured, a channel
# with a natural run of 1,400 readings was accused after 3,000 with nothing wrong.
AI_FLATLINE_ABSOLUTE_RUN=0

# Bounds on the per-device tables. Device identifiers arrive from the fleet, so
# any table that is never pruned grows with every identifier ever seen. Eviction
# is least-recently-used: the device that stopped reporting is dropped, never the
# one that has been reporting longest.
AI_FLATLINE_MAX_DEVICES=500
AI_FORECAST_CACHE_MAX_DEVICES=500
