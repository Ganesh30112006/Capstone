# ---------------------------------------------------------------------------
# AWS IoT Core: the fleet's front door.
#
#   ESP32 --MQTT/TLS + X.509--> IoT Core --IoT Rule--> SQS --> ingestion
#
# Two properties matter most here:
#
#   1. Every device authenticates with its own certificate. The deviceUid is an
#      identifier, never a credential — knowing another station's UID gets you
#      nothing, because the policy below scopes each certificate to topics
#      derived from its own Thing name.
#
#   2. Private keys are generated by IoT Core and handed to the operator once,
#      at provisioning time. They are never stored by the platform.
# ---------------------------------------------------------------------------

resource "aws_iot_thing_type" "weather_station" {
  name = "weather-station"

  properties {
    description = "Environmental monitoring station (ESP32)"
    searchable_attributes = ["deviceUid"]
  }
}

# ---------------------------------------------------------------------------
# Least-privilege device policy.
#
# The ${iot:Connection.Thing.ThingName} substitution is what makes this safe:
# it is resolved by IoT Core from the certificate presented at connect time, so
# a device physically cannot publish to another station's topics even if its
# firmware is modified to try.
# ---------------------------------------------------------------------------

locals {
  # Thing names are "weather-station-<deviceUid>", matching
  # IotProperties.thingNameFor() in device-service.
  topic_root = var.iot_topic_prefix
}

data "aws_iam_policy_document" "device_policy" {
  # Connect only as the client ID matching this certificate's Thing.
  statement {
    sid       = "ConnectAsOwnThing"
    effect    = "Allow"
    actions   = ["iot:Connect"]
    resources = ["arn:aws:iot:${var.aws_region}:${data.aws_caller_identity.current.account_id}:client/$${iot:Connection.Thing.ThingName}"]
  }

  # Publish only to this device's own uplink topics.
  statement {
    sid     = "PublishOwnUplinkTopics"
    effect  = "Allow"
    actions = ["iot:Publish"]
    resources = [
      "arn:aws:iot:${var.aws_region}:${data.aws_caller_identity.current.account_id}:topic/${local.topic_root}/$${iot:Connection.Thing.Attributes[deviceUid]}/telemetry",
      "arn:aws:iot:${var.aws_region}:${data.aws_caller_identity.current.account_id}:topic/${local.topic_root}/$${iot:Connection.Thing.Attributes[deviceUid]}/heartbeat",
      "arn:aws:iot:${var.aws_region}:${data.aws_caller_identity.current.account_id}:topic/${local.topic_root}/$${iot:Connection.Thing.Attributes[deviceUid]}/events",
    ]
  }

  # Subscribe and receive only on this device's own downlink (OTA) topic.
  statement {
    sid     = "SubscribeOwnDownlinkTopic"
    effect  = "Allow"
    actions = ["iot:Subscribe"]
    resources = [
      "arn:aws:iot:${var.aws_region}:${data.aws_caller_identity.current.account_id}:topicfilter/${local.topic_root}/$${iot:Connection.Thing.Attributes[deviceUid]}/ota",
    ]
  }

  statement {
    sid     = "ReceiveOwnDownlinkTopic"
    effect  = "Allow"
    actions = ["iot:Receive"]
    resources = [
      "arn:aws:iot:${var.aws_region}:${data.aws_caller_identity.current.account_id}:topic/${local.topic_root}/$${iot:Connection.Thing.Attributes[deviceUid]}/ota",
    ]
  }

  # Device Shadow, scoped to this device's own shadow document.
  statement {
    sid    = "ManageOwnShadow"
    effect = "Allow"
    actions = [
      "iot:GetThingShadow",
      "iot:UpdateThingShadow",
    ]
    resources = ["arn:aws:iot:${var.aws_region}:${data.aws_caller_identity.current.account_id}:thing/$${iot:Connection.Thing.ThingName}"]
  }
}

resource "aws_iot_policy" "device" {
  name   = "weather-station-device-policy"
  policy = data.aws_iam_policy_document.device_policy.json
}

# ---------------------------------------------------------------------------
# IAM role assumed by the IoT rules engine to write into SQS.
# ---------------------------------------------------------------------------

data "aws_iam_policy_document" "iot_rule_assume" {
  statement {
    effect  = "Allow"
    actions = ["sts:AssumeRole"]

    principals {
      type        = "Service"
      identifiers = ["iot.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "iot_rule" {
  name               = "${var.project_name}-${var.environment}-iot-rule-role"
  assume_role_policy = data.aws_iam_policy_document.iot_rule_assume.json
}

data "aws_iam_policy_document" "iot_rule_permissions" {
  statement {
    sid       = "SendToIngestionQueues"
    effect    = "Allow"
    actions   = ["sqs:SendMessage"]
    resources = [aws_sqs_queue.telemetry.arn, aws_sqs_queue.heartbeat.arn]
  }
}

resource "aws_iam_role_policy" "iot_rule" {
  name   = "${var.project_name}-${var.environment}-iot-rule-policy"
  role   = aws_iam_role.iot_rule.id
  policy = data.aws_iam_policy_document.iot_rule_permissions.json
}

# ---------------------------------------------------------------------------
# Rules: route MQTT topics into SQS.
#
# The SELECT enriches the payload with the topic-derived device UID and the
# broker's own receipt timestamp, so ingestion can cross-check a device's
# self-reported identity and clock rather than trusting them blindly.
# ---------------------------------------------------------------------------

resource "aws_iot_topic_rule" "telemetry_to_sqs" {
  name        = replace("${var.project_name}_${var.environment}_telemetry_to_sqs", "-", "_")
  description = "Route device telemetry into the ingestion queue"
  enabled     = true
  sql_version = "2016-03-23"

  # topic(3) is the deviceUid segment of weather/devices/{deviceUid}/telemetry.
  sql = <<-SQL
    SELECT *,
           topic(3) AS deviceUid,
           timestamp() AS brokerReceivedAt
    FROM '${local.topic_root}/+/telemetry'
  SQL

  sqs {
    queue_url  = aws_sqs_queue.telemetry.id
    role_arn   = aws_iam_role.iot_rule.arn
    use_base64 = false
  }

  # If the rule itself fails (queue unavailable, malformed action), the message
  # is preserved here instead of being dropped by the rules engine.
  error_action {
    sqs {
      queue_url  = aws_sqs_queue.telemetry_dlq.id
      role_arn   = aws_iam_role.iot_rule.arn
      use_base64 = false
    }
  }
}

resource "aws_iot_topic_rule" "heartbeat_to_sqs" {
  name        = replace("${var.project_name}_${var.environment}_heartbeat_to_sqs", "-", "_")
  description = "Route device heartbeats into the ingestion queue"
  enabled     = true
  sql_version = "2016-03-23"

  sql = <<-SQL
    SELECT *,
           topic(3) AS deviceUid,
           timestamp() AS brokerReceivedAt
    FROM '${local.topic_root}/+/heartbeat'
  SQL

  sqs {
    queue_url  = aws_sqs_queue.heartbeat.id
    role_arn   = aws_iam_role.iot_rule.arn
    use_base64 = false
  }

  error_action {
    sqs {
      queue_url  = aws_sqs_queue.heartbeat_dlq.id
      role_arn   = aws_iam_role.iot_rule.arn
      use_base64 = false
    }
  }
}

# ---------------------------------------------------------------------------
# Fleet-wide logging so a device that cannot connect can actually be diagnosed.
# ---------------------------------------------------------------------------

resource "aws_cloudwatch_log_group" "iot" {
  name              = "/aws/iot/${var.project_name}-${var.environment}"
  retention_in_days = var.log_retention_days
}

data "aws_iam_policy_document" "iot_logging_assume" {
  statement {
    effect  = "Allow"
    actions = ["sts:AssumeRole"]

    principals {
      type        = "Service"
      identifiers = ["iot.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "iot_logging" {
  name               = "${var.project_name}-${var.environment}-iot-logging-role"
  assume_role_policy = data.aws_iam_policy_document.iot_logging_assume.json
}

resource "aws_iam_role_policy_attachment" "iot_logging" {
  role       = aws_iam_role.iot_logging.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSIoTLogging"
}

resource "aws_iot_logging_options" "fleet" {
  default_log_level = var.environment == "prod" ? "WARN" : "INFO"
  role_arn          = aws_iam_role.iot_logging.arn
}

# The account's ATS data endpoint, which devices and the data-plane client use.
data "aws_iot_endpoint" "ats" {
  endpoint_type = "iot:Data-ATS"
}
