# Copy to .env.local and fill in. .env.local is not committed.

# Where the console reaches the platform. Defaults to the local gateway.
VITE_API_BASE_URL=http://localhost:8443/api

# OpenWeatherMap key for the weather overlays on the operator map
# (cloud cover, precipitation, temperature, wind).
#
# Get one at https://home.openweathermap.org/api_keys — the free tier covers
# the Weather Maps 1.0 tile endpoint these overlays use.
#
# Leave it unset and the overlay controls are disabled with a note saying why.
# That is deliberate: an overlay that renders no tiles looks exactly like a
# forecast of clear skies everywhere, so the console will not offer a control
# it cannot honour.
#
# Note on versions: the tile endpoint is Weather Maps 1.0. There is no 0.6 of
# it — 0.6 is the version of the OpenStreetMap *data* API, a different service
# that serves map geometry rather than weather and authenticates with OAuth
# rather than an API key.
VITE_OPENWEATHER_API_KEY=

# RabbitMQ management UI, linked from the console's System health page.
# Leave it unset and the link is not shown.
VITE_RABBITMQ_UI_URL=
